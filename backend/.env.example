# ── LLM ──────────────────────────────────────────────────────────────────────
# Required. Your Claude API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# ── Web search (Tavily) ────────────────────────────────────────────────────────
# Used to auto-suggest sourced facts for a brief. Without it, "Search for facts"
# in the brief builder is disabled but the rest of the app works fine.
TAVILY_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SENDER_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Abuse protection ─────────────────────────────────────────────────────────
# Number of trusted reverse proxies in front of the app, used to read the real client IP for
# rate limiting (Render = 1). Set 0 if nothing sits in front of the app.
# TRUSTED_PROXY_HOPS=1
# Most blocks a single "Generate article" call accepts (bounds the cost of one call).
# MAX_ARTICLE_BLOCKS=40

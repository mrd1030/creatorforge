# ── LLM ──────────────────────────────────────────────────────────────────────
# Required. Your Claude API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# ── Web search (Tavily) ────────────────────────────────────────────────────────
# Used to auto-suggest sourced facts for a brief. Without it, "Search for facts"
# in the brief builder is disabled but the rest of the app works fine.
TAVILY_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SENDER_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Public demo protection ────────────────────────────────────────────────────
# Set DEMO_MODE=true on a public demo: caps each IP to DEMO_DAILY_LIMIT AI calls/day and disables email.
# Leave unset for a normal private deployment.
# DEMO_MODE=true
# DEMO_DAILY_LIMIT=5
# Number of trusted proxies in front of the app (used to read the real client IP safely).
# TRUSTED_PROXY_HOPS=1

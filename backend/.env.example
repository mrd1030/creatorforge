# ── LLM ──────────────────────────────────────────────────────────────────────
# Required. Your Claude API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (defaults to claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Web search (Tavily) ────────────────────────────────────────────────────────
# Used to auto-suggest sourced facts for a brief. Without it, "Search for facts"
# in the brief builder is disabled but the rest of the app works fine.
TAVILY_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SENDER_EMAIL=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

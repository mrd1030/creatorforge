# Base URL of the running backend (see backend/.env.example).
VITE_BACKEND_URL=http://localhost:8000

# ── Sanity (optional) ───────────────────────────────────────────────────────────
# Set both to enable "Push to Sanity" in Settings/Finalize. Leave unset to disable
# that feature entirely rather than pushing into someone else's Sanity project.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
